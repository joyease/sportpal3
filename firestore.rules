rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) 
        && incoming().id == userId
        && incoming().email is string
        && incoming().name is string;
    }

    // Check-ins collection
    match /check_ins/{checkInId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().lat is number
        && incoming().lng is number;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Sport records collection
    match /sport_records/{recordId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().type is string
        && incoming().duration is number;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Flag marks collection
    match /flag_marks/{markId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().countryId is string
        && incoming().visited is bool;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Japan visits collection
    match /japan_visits/{visitId} {
      // Public read by email query is allowed for the Japan Map feature
      allow list: if true; 
      
      allow get: if true;

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().count is number
        && incoming().count >= 0
        && incoming().prefectureId is string;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().count is number
        && incoming().count >= 0;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
